{% style %}
.comparision-chart-main tr td:nth-child(2) > svg {
  fill: #fff;
}
{% endstyle %}

<div class="comparision-chart-main" style="background: {{ section.settings.bg_color }};">
  <div class="comparision-chart-main-bg-image">
    {{ section.settings.bg_image }}
  </div>
  <div class="container">
    <div class="comparision-chart-wrapper">
      <div class="comparision-chart-title">
        <h2>{{ section.settings.title }}</h2>
      </div>
      <div class="comparision-chart-table-outer">
      {% capture true_value_icon %}
        <svg width="36" height="37" viewBox="0 0 36 37" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M14.611 1.52851C14.611 0.684335 15.2848 0 16.1161 0H19.8841C20.7153 0 21.3891 0.684337 21.3891 1.52851V8.02413L25.1825 2.79415C25.6755 2.11447 26.6176 1.96935 27.2869 2.47001L30.3207 4.73955C30.9899 5.24021 31.1328 6.19706 30.6398 6.87674L27.0157 11.8734L32.8217 9.93869C33.6115 9.67552 34.4618 10.1124 34.721 10.9145L35.8956 14.5505C36.1548 15.3526 35.7246 16.2162 34.9348 16.4794L29.016 18.4516L34.9514 20.3719C35.7434 20.6281 36.1809 21.4879 35.9286 22.2922L34.7849 25.9384C34.5326 26.7427 33.686 27.187 32.894 26.9308L26.9173 24.9972L30.6357 30.1277C31.1285 30.8075 30.9853 31.7643 30.3158 32.2648L27.2813 34.5332C26.6119 35.0336 25.6697 34.8882 25.177 34.2083L21.3891 28.9821V35.4715C21.3891 36.3157 20.7153 37 19.8841 37H16.1161C15.2848 37 14.611 36.3157 14.611 35.4715V28.976L10.8178 34.2057C10.3248 34.8854 9.38266 35.0306 8.71341 34.5299L5.67964 32.2603C5.01038 31.7597 4.86749 30.8028 5.36047 30.1232L8.98463 25.1264L3.17827 27.0612C2.38848 27.3244 1.53815 26.8875 1.27902 26.0854L0.104328 22.4494C-0.154809 21.6473 0.275375 20.7837 1.06517 20.5206L6.98416 18.5483L1.04862 16.6279C0.25662 16.3717 -0.180892 15.5119 0.0714126 14.7076L1.21513 11.0614C1.46743 10.2571 2.31401 9.81276 3.10602 10.069L9.08273 12.0026L5.36437 6.8723C4.87162 6.19245 5.01485 5.23564 5.68427 4.73522L8.71883 2.46676C9.38826 1.96634 10.3304 2.11179 10.8231 2.79165L14.611 8.01789V1.52851Z" fill="white"/>
          <path fill-rule="evenodd" clip-rule="evenodd" d="M25.3238 14.349C25.595 14.6245 25.5916 15.0677 25.3161 15.3389L17.1286 23.4004C16.8561 23.6687 16.4188 23.6687 16.1464 23.4004L11.2089 18.5389C10.9334 18.2677 10.93 17.8245 11.2012 17.549L12.3238 16.4089C12.595 16.1334 13.0382 16.13 13.3137 16.4012L16.1464 19.1903C16.4188 19.4586 16.8561 19.4586 17.1286 19.1903L23.2113 13.2012C23.4868 12.93 23.93 12.9334 24.2012 13.2089L25.3238 14.349Z" fill="black"/>
        </svg>
      {% endcapture %}
      {% capture false_value_icon %}
        <svg width="36" height="37" viewBox="0 0 36 37" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="18" cy="18.5" r="16.5" stroke="#F57D24" stroke-width="3"/>
          <path d="M17.5807 20.9731C17.8453 20.7085 18.2744 20.7085 18.539 20.9731L23.3849 25.819C23.6495 26.0837 24.0786 26.0837 24.3432 25.819L25.3151 24.8471C25.5798 24.5825 25.5798 24.1535 25.3151 23.8888L20.4692 19.0429C20.2046 18.7783 20.2046 18.3492 20.4692 18.0846L25.3151 13.2387C25.5798 12.974 25.5798 12.545 25.3151 12.2804L24.3432 11.3084C24.0786 11.0438 23.6495 11.0438 23.3849 11.3084L18.539 16.1544C18.2744 16.419 17.8453 16.419 17.5807 16.1544L12.6248 11.1985C12.3601 10.9338 11.9311 10.9338 11.6665 11.1985L10.6946 12.1704C10.4299 12.435 10.4299 12.8641 10.6946 13.1287L15.6505 18.0846C15.9151 18.3492 15.9151 18.7783 15.6505 19.0429L10.6946 23.9988C10.4299 24.2634 10.4299 24.6925 10.6946 24.9571L11.6665 25.929C11.9311 26.1936 12.3601 26.1936 12.6248 25.929L17.5807 20.9731Z" fill="#F57E25"/>
        </svg>
      {% endcapture %}

      {% comment %}{% assign heading_col_1 = section.blocks[0].block.settings.heading_col_1 | strip %}{% endcomment %}
      {% assign heading_col_2 = section.blocks.first.settings.heading_col_2 | strip %}
      {% assign heading_col_3 = section.blocks.first.settings.heading_col_3 | strip %}
      {% assign heading_col_4 = section.blocks.first.settings.heading_col_4 | strip %}
      {% assign heading_col_5 = section.blocks.first.settings.heading_col_5 | strip %}

        <table width="100%">
          {% for block in section.blocks %}
            <tr>
              {% case block.type %}
                {% when 'comparision_heading' %}
                  <th>{{ block.settings.heading_col_1 }}</th>
                  {% if heading_col_2 != "" %}<th>{{ block.settings.heading_col_2 }}</th>{% endif %}
                  {% if heading_col_3 != "" %}<th>{{ block.settings.heading_col_3 }}</th>{% endif %}
                  {% if heading_col_4 != "" %}<th>{{ block.settings.heading_col_4 }}</th>{% endif %}
                  {% if heading_col_5 != "" %}<th>{{ block.settings.heading_col_5 }}</th>{% endif %}
                
                {% when 'comparision_rows' %}
                  <td colspan="0">{{ block.settings.row_col_1 }}</td>
                  {% if heading_col_2 != "" %}
                    <td colspan="0">
                      {% if block.settings.row_col_2 %}
                        {{ true_value_icon }}
                      {% else %}
                        {{ false_value_icon }}
                      {% endif %}
                    </td>
                  {% endif %}
                  {% if heading_col_3 != "" %}
                    <td colspan="0">
                      {% if block.settings.row_col_3 %}
                        {{ true_value_icon }}
                      {% else %}
                        {{ false_value_icon }}
                      {% endif %}
                    </td>
                  {% endif %}
                  {% if heading_col_4 != "" %}
                    <td colspan="0">
                      {% if block.settings.row_col_4 %}
                        {{ true_value_icon }}
                      {% else %}
                        {{ false_value_icon }}
                      {% endif %}
                    </td>
                  {% endif %}
                  {% if heading_col_5 != "" %}
                    <td colspan="0">
                      {% if block.settings.row_col_5 %}
                        {{ true_value_icon }}
                      {% else %}
                        {{ false_value_icon }}
                      {% endif %}
                    </td>
                  {% endif %}
                {% else %}
                  {% comment %}Do Nothing{% endcomment %}
              {% endcase %}
            </tr>
          {% endfor %}
        </table>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Comparision Chart",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color"
    },
    {
      "type": "textarea",
      "id": "bg_image",
      "label": "Background Image"
    }
  ],
  "max_blocks": 8,
  "blocks": [
    {
      "type": "comparision_heading",
      "name": "Comparision Heading",
      "settings": [
        {
          "type": "textarea",
          "id": "heading_col_1",
          "label": "Heading Column 1"
        },
        {
          "type": "textarea",
          "id": "heading_col_2",
          "label": "Heading Column 2"
        },
        {
          "type": "textarea",
          "id": "heading_col_3",
          "label": "Heading Column 3"
        },
        {
          "type": "textarea",
          "id": "heading_col_4",
          "label": "Heading Column 4"
        },
        {
          "type": "textarea",
          "id": "heading_col_5",
          "label": "Heading Column 5"
        }
      ]
    },
    {
      "type": "comparision_rows",
      "name": "Comparision Rows",
      "settings": [
        {
          "type": "text",
          "id": "row_col_1",
          "label": "Feature"
        },

        {
          "type": "checkbox",
          "id": "row_col_2",
          "label": "Feature column 2",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "row_col_3",
          "label": "Feature column 3",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "row_col_4",
          "label": "Feature column 4",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "row_col_5",
          "label": "Feature column 5",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Comparision Chart"
    }
  ]
}
{% endschema %}
