                {%  else%}
              <p>40% OFF DEAL ENDING SOON (<a href="https://trycreate.co/pages/orange-g#subs-product" title="https://trycreate.co/pages/orange-g#subs-product"><span style="text-decoration:underline"><strong>SHOP NOW</strong></span></a>)</p>
               {%  endif %}       
        {%  elsif template == "page.orange-fb2" %}
          <p>40% OFF DEAL ENDING SOON (<a href="https://trycreate.co/pages/orange-fb2#subs-product" title="https://trycreate.co/pages/orange-fb2#subs-product"><span style="text-decoration:underline"><strong>SHOP NOW</strong></span></a>)</p>
        {%  elsif template == "page.orange-fb3" %}
