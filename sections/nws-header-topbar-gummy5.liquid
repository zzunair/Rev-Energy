          {%  elsif template == "page.blueraspberry-fb" %}
              {%  if page.handle == "blueraspberry-fb" %}
              <p>40% OFF DEAL ENDING SOON (<a href="https://trycreate.co/pages/blueraspberry-fb#subs-product" title="https://trycreate.co/pages/blueraspberry-fb#subs-product"><span style="text-decoration:underline"><strong>SHOP NOW</strong></span></a>)</p>
              {%  elsif page.handle == "blueraspberry-tt" %}
