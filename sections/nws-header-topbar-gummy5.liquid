            <p>45% OFF DEAL ENDING SOON (<a href="https://trycreate.co/pages/starterpack-fb#subs-product" title="https://trycreate.co/pages/starterpack-fb#subs-product"><span style="text-decoration:underline"><strong>SHOP NOW</strong></span></a>)</p>
          {%  elsif template == "page.starterpack-fb2" %}
            <p>45% OFF DEAL ENDING SOON (<a href="https://trycreate.co/pages/starterpack-fb2#subs-product" title="https://trycreate.co/pages/starterpack-fb2#subs-product"><span style="text-decoration:underline"><strong>SHOP NOW</strong></span></a>)</p>
        {%  elsif template == "page.starterpack-fb4" or template == "page.starterpack-fb4-fix" %}
