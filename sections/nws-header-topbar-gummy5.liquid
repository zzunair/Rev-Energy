                {%  else%}
              <p>40% OFF DEAL ENDING SOON (<a href="https://trycreate.co/pages/blueraspberry-g#subs-product" title="https://trycreate.co/pages/blueraspberry-g#subs-product"><span style="text-decoration:underline"><strong>SHOP NOW</strong></span></a>)</p>
               {%  endif %}
      {%  elsif template == "page.blueraspberry-fb2" %}
        <p>40% OFF DEAL ENDING SOON (<a href="https://trycreate.co/pages/blueraspberry-fb2#subs-product" title="https://trycreate.co/pages/blueraspberry-fb2#subs-product"><span style="text-decoration:underline"><strong>SHOP NOW</strong></span></a>)</p>
        {%  else %}
              {%  if page.handle == "watermelon-fb" %}
                <p>40% OFF DEAL ENDING SOON (<a href="https://trycreate.co/pages/watermelon-fb#subs-product" title="https://trycreate.co/pages/watermelon-fb#subs-product"><span style="text-decoration:underline"><strong>SHOP NOW</strong></span></a>)</p>
              {% elsif page.handle == "watermelon-fb2" %}
