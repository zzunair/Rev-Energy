                      <path d="M51.1281 4.31373C50.6753 3.36483 49.3246 3.36482 48.8718 4.31373L47.4823 7.22574L44.2834 7.64741C43.241 7.78482 42.8237 9.06941 43.5862 9.79327L45.9263 12.0147L45.3388 15.1873C45.1474 16.2211 46.2401 17.015 47.1642 16.5135L50 14.9744L52.8358 16.5135C53.7599 17.015 54.8526 16.2211 54.6612 15.1873L54.0737 12.0147L56.4138 9.79327C57.1763 9.06941 56.7589 7.78482 55.7166 7.64741L52.5177 7.22574L51.1281 4.31373Z" fill="#FF9807" stroke="#10443C"/>
                      <path d="M71.1281 4.31373C70.6753 3.36483 69.3246 3.36482 68.8718 4.31373L67.4823 7.22574L64.2834 7.64741C63.241 7.78482 62.8237 9.06941 63.5862 9.79327L65.9263 12.0147L65.3388 15.1873C65.1474 16.2211 66.2401 17.015 67.1642 16.5135L70 14.9744L72.8358 16.5135C73.7599 17.015 74.8526 16.2211 74.6612 15.1873L74.0737 12.0147L76.4138 9.79327C77.1763 9.06941 76.7589 7.78482 75.7166 7.64741L72.5177 7.22574L71.1281 4.31373Z" fill="#FF9807" stroke="#10443C"/>
                      <path d="M91.1281 4.31373C90.6753 3.36483 89.3246 3.36482 88.8718 4.31373L87.4823 7.22574L84.2834 7.64741C83.241 7.78482 82.8237 9.06941 83.5862 9.79327L85.9263 12.0147L85.3388 15.1873C85.1474 16.2211 86.2401 17.015 87.1642 16.5135L90 14.9744L92.8358 16.5135C93.7599 17.015 94.8526 16.2211 94.6612 15.1873L94.0737 12.0147L96.4138 9.79327C97.1763 9.06941 96.7589 7.78482 95.7166 7.64741L92.5177 7.22574L91.1281 4.31373Z" fill="#FF9807" stroke="#10443C"/>
                      </svg>
                    </div>
                  </div>
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
      <div class="swiper happy-customers__swiper happy-customers__swiper--rtl">
        <div class="swiper-wrapper">
          {% for block in section.blocks %}
            {% if block.type == 'review_ltr' %}
              <div class="swiper-slide happy-customers__slide" {{ block.shopify_attributes }}>
                <div class="happy-customers__card">
                  {% if block.settings.title != blank %}
                    <h3 class="happy-customers__quote">{{ block.settings.title }}</h3>
                  {% endif %}
                  {% if block.settings.description != blank %}
                    <p class="happy-customers__description">{{ block.settings.description }}</p>
                  {% endif %}
                  <div class="happy-customers__user-info">
                    {% if block.settings.user_image != blank %}
                      <img src="{{ block.settings.user_image | image_url: width: 60 }}" alt="{{ block.settings.user_name }}" class="happy-customers__user-image" loading="lazy">
                    {% endif %}
                    <div class="bottom__stars">
                      <div>
                        {% if block.settings.user_name != blank %}
                          <div class="happy-customers__user-name">{{ block.settings.user_name }}</div>
                        {% endif %}
                        {% if block.settings.user_location != blank %}
                          <div class="happy-customers__user-location">{{ block.settings.user_location }}</div>
                        {% endif %}
                      </div>
