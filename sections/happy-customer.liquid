<!-- Basic SwiperJS Init (You should customize it based on your theme setup) -->
<script>
var swiperLtr = new Swiper('.happy-customers__swiper--ltr', {
  slidesPerView: 1.1,
  spaceBetween: 20,
  centeredSlides: true,
  loop: true,
  speed: 4000,
  autoplay: {
    delay: 1,
    disableOnInteraction: false,
  },
  freeMode: {
    enabled: true,
    sticky: false,
  },
  allowTouchMove: false,
  direction: 'horizontal',
  breakpoints: {
    700: {
      slidesPerView: 2.2,
    },
    1025: {
      slidesPerView: 3.2,
    },
    1200: {
      slidesPerView: 4.2,
    }
  }
});

var swiperRtl = new Swiper('.happy-customers__swiper--rtl', {
  slidesPerView: 1.1,
  spaceBetween: 20,
  loop: true,
  centeredSlides: false,
  speed: 4000,
  autoplay: {
    delay: 1,
    disableOnInteraction: false,
    reverseDirection: true, // makes it go opposite
  },
  freeMode: {
    enabled: true,
    sticky: false,
  },
  allowTouchMove: false,
  direction: 'horizontal',
  breakpoints: {
    700: {
      slidesPerView: 2.2,
    },
    1025: {
      slidesPerView: 3.2,
    },
    1200: {
      slidesPerView: 4.2,
    }
  }
});
</script>

{% schema %}
{
  "name": "Happy Customers",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "20,000+ Happy Customers"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Read All Reviews"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    }
  ],
  "blocks": [
    {
      "type": "review_rtl",
      "name": "Review 1",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Review Title",
          "default": "Game Changer For My Workouts."
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Review Description",
          "default": "I pop a piece before every lift. No crash, just clean energy that kicks in fast. Chew Rev's the real deal."
        },
        {
          "type": "image_picker",
          "id": "user_image",
          "label": "User Image"
        },
        {
          "type": "text",
          "id": "user_name",
          "label": "User Name",
          "default": "Marcus T."
        },
        {
          "type": "text",
          "id": "user_location",
          "label": "User Location",
          "default": "Log Angeles, CA"
        }
      ]
    },
    {
      "type": "review_ltr",
      "name": "Review 2",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Review Title",
          "default": "Game Changer For My Workouts."
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Review Description",
          "default": "I pop a piece before every lift. No crash, just clean energy that kicks in fast. Chew Rev's the real deal."
        },
        {
          "type": "image_picker",
          "id": "user_image",
          "label": "User Image"
        },
        {
          "type": "text",
          "id": "user_name",
          "label": "User Name",
          "default": "Marcus T."
        },
        {
          "type": "text",
          "id": "user_location",
          "label": "User Location",
          "default": "Log Angeles, CA"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Happy Customers"
    }
  ]
}
{% endschema %}
