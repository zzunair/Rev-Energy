      </svg>
    </div>
    {% if section.settings.heading != blank %}
      <h2 class="happy-customers__heading">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.button_label != blank and section.settings.button_url != blank %}
      <div class="happy-customers__button-wrapper">
        <a href="{{ section.settings.button_url }}" class="happy-customers__button">{{ section.settings.button_label }}</a>
      </div>
    {% endif %}
    <div class="happy-customers__sliders">
      <!-- First Swiper -->
      <div class="swiper happy-customers__swiper happy-customers__swiper--ltr" dir="ltr">
        <div class="swiper-wrapper">
          {% for block in section.blocks %}
            {% if block.type == 'review_rtl' %}
              <div class="swiper-slide happy-customers__slide" {{ block.shopify_attributes }}>
                <div class="happy-customers__card">
                  {% if block.settings.title != blank %}
                    <h3 class="happy-customers__quote">{{ block.settings.title }}</h3>
                  {% endif %}
                  {% if block.settings.description != blank %}
                    <p class="happy-customers__description">{{ block.settings.description }}</p>
                  {% endif %}
                  <div class="happy-customers__user-info">
                    {% if block.settings.user_image != blank %}
                      <img src="{{ block.settings.user_image | image_url: width: 60 }}" alt="{{ block.settings.user_name }}" class="happy-customers__user-image" loading="lazy">
                    {% endif %}
                    <div class="bottom__stars">
                      <div>
                        {% if block.settings.user_name != blank %}
                          <div class="happy-customers__user-name">{{ block.settings.user_name }}</div>
                        {% endif %}
                        {% if block.settings.user_location != blank %}
                          <div class="happy-customers__user-location">{{ block.settings.user_location }}</div>
                        {% endif %}
                      </div>
                      <svg width="100" height="21" viewBox="0 0 100 21" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M11.1281 4.31373C10.6753 3.36483 9.32464 3.36482 8.87185 4.31373L7.48231 7.22574L4.28343 7.64741C3.24105 7.78482 2.82365 9.06941 3.58619 9.79327L5.92629 12.0147L5.33882 15.1873C5.14738 16.2211 6.24012 17.015 7.16419 16.5135L9.99999 14.9744L12.8358 16.5135C13.7599 17.015 14.8526 16.2211 14.6612 15.1873L14.0737 12.0147L16.4138 9.79327C17.1763 9.06941 16.7589 7.78482 15.7166 7.64741L12.5177 7.22574L11.1281 4.31373Z" fill="#FF9807" stroke="#10443C"/>
