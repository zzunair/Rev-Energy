  $('#shopify-section-{{ section.id }} .flavors div[data-quantity="increase"]').click(function () {
       $(this).each(function() {
		if ($(this).prev().val() < 4) {
    	$(this).prev().val(+$(this).prev().val() + 1);
		}
        findTotal();
      });
  });

  $('#shopify-section-{{ section.id }} .flavors div[data-quantity="decrease"]').click(function () {
		if ($(this).next().val() > 0) {
    	if ($(this).next().val() > 0) $(this).next().val(+$(this).next().val() - 1);
		}

		if ($(this).next().val() == 0) {
        $(this).parents(".flavor2_quantity-container").prev(".flavor_add-btn").addClass("is-active");
		}
        findTotal();
  });


 


