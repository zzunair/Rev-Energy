<script>
    $('#shopify-section-{{ section.id }} .quantity-selector_card').click(function() {
      $('#shopify-section-{{ section.id }} .quantity-selector_card').removeClass("current-qty");

       $(this).each(function() {
            $(this).addClass("current-qty");

            // Gifts Functions
            var data_qty = $(this).data("qty");

            if(data_qty == "4"){
              $("#shopify-section-{{ section.id }} .gift_card[data-gift='1']").addClass("is-active");
              $("#shopify-section-{{ section.id }} .gift_card[data-gift='2']").addClass("is-active");
              $("#shopify-section-{{ section.id }} .gift_card[data-gift='3']").addClass("is-active");
              $("#shopify-section-{{ section.id }} .gift_card[data-gift='4']").addClass("is-active");
              $("#shopify-section-{{ section.id }} span[data-bundle='saving-pct']").text("58");
              $("#shopify-section-{{ section.id }} span.days-sub").text("120");
              $("#shopify-section-{{ section.id }} .cta1_button-content span.bags-select").text("4 bags").attr("data-bags","4");
              $(".navbar-container span.bags-select").text("4 bags").attr("data-bag","4");;
              
            }
           else if(data_qty == "3"){
              $("#shopify-section-{{ section.id }} .gift_card[data-gift='1']").addClass("is-active");
              $("#shopify-section-{{ section.id }} .gift_card[data-gift='2']").addClass("is-active");
              $("#shopify-section-{{ section.id }} .gift_card[data-gift='3']").addClass("is-active");
              $("#shopify-section-{{ section.id }} .gift_card[data-gift='4']").removeClass("is-active");
              $("#shopify-section-{{ section.id }} span[data-bundle='saving-pct']").text("53");
              $("#shopify-section-{{ section.id }} span.days-sub").text("90");
              $("#shopify-section-{{ section.id }} .cta1_button-content span.bags-select").text("3 bags").attr("data-bags","3");
              $(".navbar-container span.bags-select").text("3 bags").attr("data-bag","3");;
            }
           else if(data_qty == "2"){
              $("#shopify-section-{{ section.id }} .gift_card[data-gift='1']").addClass("is-active");
              $("#shopify-section-{{ section.id }} .gift_card[data-gift='2']").addClass("is-active");
              $("#shopify-section-{{ section.id }} .gift_card[data-gift='3']").removeClass("is-active");
              $("#shopify-section-{{ section.id }} .gift_card[data-gift='4']").removeClass("is-active");
              $("#shopify-section-{{ section.id }} span[data-bundle='saving-pct']").text("44");
              $("#shopify-section-{{ section.id }} span.days-sub").text("60");
              $("#shopify-section-{{ section.id }} .cta1_button-content span.bags-select").text("2 bags").attr("data-bags","2");
              $(".navbar-container span.bags-select").text("2 bags").attr("data-bag","2");;
            }
          else{
              $("#shopify-section-{{ section.id }} .gift_card[data-gift='1']").addClass("is-active");
              $("#shopify-section-{{ section.id }} .gift_card[data-gift='2']").removeClass("is-active");
              $("#shopify-section-{{ section.id }} .gift_card[data-gift='3']").removeClass("is-active");
              $("#shopify-section-{{ section.id }} .gift_card[data-gift='4']").removeClass("is-active");
              $("#shopify-section-{{ section.id }} span[data-bundle='saving-pct']").text("37");
              $("#shopify-section-{{ section.id }} span.days-sub").text("30");
              $("#shopify-section-{{ section.id }} .cta1_button-content span.bags-select").text("1 bag").attr("data-bags","1");
              $(".navbar-container span.bags-select").text("1 bag").attr("data-bag","1");
            }

         
        });
    
    });

   // Flavor Functions
    $('#shopify-section-{{ section.id }} .flavor_add-btn').click(function() {
       $(this).each(function() {
            $(this).removeClass("is-active");
            $(this).parents(".flavor2_quantity-2").find(".flavor_qty-display").addClass("is-active").val(1);
            findTotal();
        });
    });

  $('#shopify-section-{{ section.id }} .flavor div[data-quantity="increase"]').click(function () {
       $(this).each(function() {
		if ($(this).prev().val() < 4) {
    	$(this).prev().val(+$(this).prev().val() + 1);
		}
        findTotal();
      });
  });

  $('#shopify-section-{{ section.id }} .flavor div[data-quantity="decrease"]').click(function () {
		if ($(this).next().val() > 0) {
    	if ($(this).next().val() > 0) $(this).next().val(+$(this).next().val() - 1);
		}

		if ($(this).next().val() == 0) {
