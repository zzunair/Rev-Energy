                                const day = date.getDate();
                                const month = date.toLocaleString('default', {
                                  month: 'short'
                                });
                                let suffix = suffixes[0]; // Default to "th"
                                if (day % 10 >= 1 && day % 10 <= 3 && day != 11 && day != 12 && day != 13) {
