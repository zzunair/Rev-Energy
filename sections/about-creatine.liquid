<section class="about-creatine">
    <div class="container">
        <div class="body">
            <div class="content">
                <div class="left-side">
                    <div class="left-content">
                      {% if section.settings.heading != blank %}
                        <h2 class="section-heading">{{ section.settings.heading }}</h2>
                      {% endif %}
                      {% if section.settings.text-area != blank %}
                        <p>{{ section.settings.text-area }}</p>
                      {% endif %}
                    </div>
                </div>
                <div class="center">
                  {% if section.settings.center-img != blank %}
                    <div class="img-box">
                        <img src="{{ section.settings.center-img | img_url: 'master' }}" alt="" width="auto" height="auto">
                    </div>
                  {% endif %}
                </div>
                <div class="right-side">
                    <div class="content">
                        {% for block in section.blocks %}
                          {% if block.settings.para != blank %}
                            <div class="para-{{ forloop.index }}">{{ block.settings.para }}</div>
                          {% endif %}
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
{% schema %}
{
  "name": "About Creatine",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "textarea",
      "id": "text-area",
      "label": "Sub Heading"
    },
    {
      "type": "image_picker",
      "id": "center-img",
      "label": "Select Image"
    }
  ],
  "blocks": [
    {
      "type": "block",
      "name": "text",
      "settings": [
        {
          "type": "richtext",
          "id": "para",
          "label": "Text"
        },
        {
          "type": "checkbox",
          "id": "text-border",
          "label": "Border",
          "default": false
        },
        {
          "type": "range",
          "id": "t-size",
          "min": 12,
          "max": 18,
          "default": 16,
          "step": 1,
          "unit": "px",
          "label": "Font Size"
        },
        {
          "type": "color",
          "id": "t-color",
          "default": "#FFF2D2",
          "label": "Text Color"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About Creatine",
      "category": "Section Category"
    }
  ]
}
{% endschema %}
<style>
section.about-creatine {
    display: block;
}
section.about-creatine .container {
    display: block;
    width: 100%;
    max-width: 1340px;
    margin: 0 auto;
    padding: 0 10px;
}
section.about-creatine .container .body {
    display: block;
    background-color: #333333;
    border-radius: 10px;
    padding: 44px;
}
section.about-creatine .body .content {
    display: flex;
}
section.about-creatine .body .left-side {
    display: block;
    width: 100%;
    max-width: 33.33%;
    padding: 0 10px;
}
section.about-creatine .left-side .left-content {
    display: block;
    width: 100%;
    max-width: 335px;
    margin: 0 auto;
    padding-top: 55px;
}
section.about-creatine .left-content h2.section-heading {
	display: block;
	color: #F77F26;
	font-family: PPObjectSans;
	font-size: 42px;
	margin: 0;
	margin-bottom: 12px;
	max-width: 295px;
	width: 100%;
}
section.about-creatine .left-content h2.section-heading span {
    display: block;
}
section.about-creatine .left-content p {
    display: block;
    font-size: 16px;
    margin: 0;
    color: #FFF2D2;
    line-height: normal;
}

section.about-creatine .body .center {
    display: block;
    width: 100%;
    max-width: 33.33%;
    padding: 0 10px;
}
section.about-creatine .center .img-box {
    display: block;
    height: 100%;
}
section.about-creatine .center .img-box img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
}
section.about-creatine .body .right-side {
    display: block;
    width: 100%;
    max-width: 33.33%;
    padding: 0 10px;
}
section.about-creatine .right-side .content {
    display: block;
    width: 100%;
    max-width: 310px;
    margin: 0 auto;
    padding-top: 55px;
}
{% for block in section.blocks %}
section.about-creatine .right-side .para-{{ forloop.index }} {
    display: block;
    font-size: {{ block.settings.t-size }}px;
    border-left: {% if block.settings.text-border == true %} 5px solid #F77F26 {% else %} none {% endif %};
    padding-left: 10px;
    margin: 0;
    margin-bottom: 22px;
    color: {{ block.settings.t-color }};
    line-height: normal;
}
{% endfor %}

@media screen and (min-width:1920px){
  section.about-creatine .container {
  	max-width: 1840px;
  }
}  
@media screen and (max-width: 1280px) {
    section.about-creatine .left-content h2.section-heading {
        font-size: 38px;
    }
    section.products .header-part h2 {
        font-size: 38px;
    }
}
@media screen and (max-width: 991px) {
    section.about-creatine .container {
        max-width: 700px;
    }
    section.about-creatine .body .content {
        flex-direction: column;
        padding: 0;
    }
    section.about-creatine .body .left-side {
        max-width: unset;
        margin-bottom: 25px;
    }
    section.about-creatine .left-side .left-content {
        max-width: 370px;
        margin: 0 auto;
        padding-top: 0;
        text-align: center;
    }
    section.about-creatine .left-content h2.section-heading span {
        display: inline;
    }
    section.about-creatine .body .center {
        max-width: 100%;
        margin-bottom: 25px;
    }
    section.about-creatine .center .img-box {
        max-width: 370px;
        margin: 0 auto;
    }
    section.about-creatine .body .right-side {
        max-width: unset;
    }
}
@media screen and (max-width: 768px) {
    section.about-creatine .left-content h2.section-heading {
        font-size: 36px;
    }
    section.about-creatine .left-content p {
        font-size: 14px;
    }
    section.about-creatine .left-side .left-content {
        max-width: 290px;
    }
    section.about-creatine .right-side .para {
        font-size: 14px;
    }
    {% for block in section.blocks %}
      section.about-creatine .right-side .para-{{ forloop.index }} {
          font-size: 14px;
      }
    {% endfor %}
}
@media screen and (max-width: 520px) {
    section.about-creatine .left-content h2.section-heading {
        font-size: 28px;
    }
    section.about-creatine .left-content p {
        font-size: 12px;
    }
    section.about-creatine .center .img-box {
        max-width: 290px;
    }
    section.about-creatine .left-side .left-content {
        max-width: 280px;
    }
    section.about-creatine .right-side .para {
        font-size: 12px;
    }
}
</style>