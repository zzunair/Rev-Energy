<script type="application/ld+json">
  {
    "@context": "http://schema.org/",
    "@type": "Product",
    "name": {{ product.title | json }},
    "url": {{ request.origin | append: product.url | json }},
    {% if seo_media -%}
      "image": [
        {{ seo_media | image_url: width: 1920 | prepend: "https:" | json }}
      ],
    {%- endif %}
    "description": {{ product.description | strip_html | json }},
    {% if product.selected_or_first_available_variant.sku != blank -%}
      "sku": {{ product.selected_or_first_available_variant.sku | json }},
    {%- endif %}
    "brand": {
      "@type": "Brand",
      "name": {{ product.vendor | json }}
    },
    "offers": [
      {%- for variant in product.variants -%}
        {
          "@type" : "Offer",
          {%- if variant.sku != blank -%}
            "sku": {{ variant.sku | json }},
          {%- endif -%}
          {%- if variant.barcode.size == 12 -%}
            "gtin12": {{ variant.barcode }},
          {%- endif -%}
          {%- if variant.barcode.size == 13 -%}
            "gtin13": {{ variant.barcode }},
          {%- endif -%}
          {%- if variant.barcode.size == 14 -%}
            "gtin14": {{ variant.barcode }},
          {%- endif -%}
          "availability" : "http://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
          "price" : {{ variant.price | divided_by: 100.00 | json }},
          "priceCurrency" : {{ cart.currency.iso_code | json }},
          "url" : {{ request.origin | append: variant.url | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>

<script>
  window.variantMetafieldData = {};
  let tempColor = "";
  let tempImages = [];
  let description = "";
  let variant_per_day_count = "";
  let variant_total_count = "";
  let tempvideo = "";
  let tempVariantBadges = "";
  let tempVariantIngredients = "";
  let tempVariantDirections = "";
  let videoId = "";
  let tempVariantHideShipFreeInRechargeWidget = false;
  let tempVariantShipFreeMessageInRechargeWidget = "";
  
  {% for variant in product.variants %}
    tempImages = [];
    tempvideo = "";
    tempVariantBadges = "";
    videoId = "";
    tempVariantHideShipFreeInRechargeWidget = false;
    tempVariantShipFreeMessageInRechargeWidget = "";
    description = "";
    
    {% if variant.metafields.custom.variant_main_color %}
      tempColor = `{{ variant.metafields.custom.variant_main_color | replace: "#","" }}`; 
    {% endif %}

    {% if variant.metafields.custom.variant_description %}
      description = `{{ variant.metafields.custom.variant_description | metafield_tag }}`; 
    {% endif %}

    {% if variant.metafields.custom.variant_total_count %}
      variant_total_count = `{{ variant.metafields.custom.variant_total_count }}`; 
    {% endif %}

    {% if variant.metafields.custom.variant_per_day_count %}
      variant_per_day_count = `{{ variant.metafields.custom.variant_per_day_count }}`; 
    {% endif %}

    {% if variant.metafields.custom.variant_product_images %}
      {% capture prod_images_liquid %} {% render 'product-images-js', variant: variant %} {% endcapture %}
      tempImages = {{ variant.metafields.custom.variant_product_images.value | json }}; 
      tempImagesHTML = `{{ prod_images_liquid | strip_newlines  }}`
    {% endif %}

    {% if variant.metafields.custom.variant_product_images %}
      {% capture temp_video_liquid %} {% render 'variant-based-video', current_variant: variant, from_js: false %} {% endcapture %}
        tempvideo = `{{ temp_video_liquid | strip_newlines  }}`
    {% endif %}
    
    {% if variant.metafields.custom.variant_product_images %}
      {% capture variant_badges %} {% render 'variant-product-badges', current_variant: variant %} {% endcapture %}
      tempVariantBadges = `{{ variant_badges | strip_newlines  }}`
    {% endif %}
    {%- comment -%}
    {% if variant.metafields.custom.variant_product_images %}
      {% capture variant_faqs %} {% render 'variant-based-faq', current_variant: variant %} {% endcapture %}
      tempVariantfaqs = `{{ variant_faqs | strip_newlines  }}`
    {% endif %}
      
    {%- endcomment -%}

    {% if variant.metafields.custom.variant_directions %}
       tempVariantDirections = `{{ variant.metafields.custom.variant_directions | metafield_tag }}`;
    {% endif %}

    {% if variant.metafields.custom.variant_ingredients %}
       tempVariantIngredients = `{{ variant.metafields.custom.variant_ingredients | metafield_tag }}`;
    {% endif %}

    {% if variant.metafields.custom.hide_ship_free_text_in_recharge_widget.value %}
       tempVariantHideShipFreeInRechargeWidget = {{ variant.metafields.custom.hide_ship_free_text_in_recharge_widget.value }};
    {% endif %}

    {% if variant.metafields.custom.free_ship_message_in_recharge %}
       tempVariantShipFreeMessageInRechargeWidget = `{{ variant.metafields.custom.free_ship_message_in_recharge }}`;
    {% endif %}

    videoId = `{{ variant.metafields.custom.variant_video_metaobject.value.video_id }}`
    
    window.variantMetafieldData[{{ variant.id }}] = {
      productMainColor: tempColor ,
      images: tempImages || [],
      tempImagesHTML: ( typeof tempImagesHTML !== "undefined" ) ? tempImagesHTML : null,
      description: description,
      variantTotalCount: variant_total_count,
      variantPerDayCount: variant_per_day_count,
      special_discount: {{ product.metafields.custom.special_discount | default: 0 }},
      variant_video: tempvideo,
      variant_video_id: videoId,
      variant_badges: tempVariantBadges,
      // variant_faqs: tempVariantfaqs,
      variant_directions:tempVariantDirections,
      variant_ingredients: tempVariantIngredients,
      variant_hide_ship_free_in_recharge_widget: tempVariantHideShipFreeInRechargeWidget,
      tempVariantShipFreeMessageInRechargeWidget: tempVariantShipFreeMessageInRechargeWidget
    };
  {% endfor %}

  window.currentVariant = {{ product.selected_or_first_available_variant | json }}
</script>

