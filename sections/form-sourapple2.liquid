

<style>


 #shopify-section-{{ section.id }}.spaced-section .grid {
    display: flex;
    flex-wrap: wrap;
    margin-bottom: 2rem;
    margin-left: -.5rem;
    padding: 0;
    list-style: none;
}

 #shopify-section-{{ section.id }}.spaced-section .grid__item {
    padding-left: .5rem;
    padding-bottom: .5rem;
    width: calc(25% - .375rem);
    max-width: 50%;
    flex-grow: 1;
    flex-shrink: 0;
}

 #shopify-section-{{ section.id }}.spaced-section  .product__info-wrapper.grid__item .metafield-rich_text_field em {
    font-style: normal;
    color: #de0000 !important;
    font-weight: 700;
    font-size: 14px;
    line-height: 1;
    padding: 0pc;
    margin: 0pc;
    text-transform: uppercase;
}

 #shopify-section-{{ section.id }}.spaced-section  .custom-heading {
    color: #00943b;
   padding: 30px 0px 10px;
}

 #shopify-section-{{ section.id }} .slider-galeria {
    float: unset;
    width: 100%;
    border: 1px solid;
    border-radius: 11px;
    margin-bottom: 20px;
}

 #shopify-section-{{ section.id }} .slider-galeria img {
    border-radius: 11px;
}

 #shopify-section-{{ section.id }}  .slider-galeria-thumbs img {
    border: 1px solid;
    border-radius: 11px;
}

 #shopify-section-{{ section.id }} .slider-galeria-thumbs {
    float: unset; 
    width: 100%;
    margin-right: 0%; 
}

 #shopify-section-{{ section.id }} .slider-galeria-thumbs .slick-slide {
      margin: 0 5px;
  }

 #shopify-section-{{ section.id }} .slider-galeria-thumbs .slick-list {
      margin: 0 -5px;
}

 #shopify-section-{{ section.id }} .product:after {
    display:none;
}

 #shopify-section-{{ section.id }} h3.h1.custom-subheading {
    text-align: center;
    font-weight: 500;
    font-size: 16px;
    margin-bottom: 5px;
}

 #shopify-section-{{ section.id }} .product__text.top-text {
    text-align: center;
    display: block;
    max-width: 450px;
    width: 450px;
    font-weight: 800;
    font-size: 24px;
    margin-bottom: 10px;
}

 #shopify-section-{{ section.id }} .slider-galeria .slick-list.draggable {
    margin-bottom: 20px;
    border-radius: 11px;
}

 #shopify-section-{{ section.id }} .product {
    column-gap: 30px;
}

#shopify-section-{{ section.id }} .subdiv {
    display: flex;
    row-gap: 10px;
    position: relative;
    max-width: 100%;
    min-width: auto;
    column-gap: 10px;
    flex-basis: auto;
    min-height: auto;
    align-items: flex-start;
    flex-shrink: 0;
    margin-left: 5px;
    padding-bottom: 40px;
    justify-content: center;
    text-align: center;
    margin: auto;
}

#shopify-section-{{ section.id }} .subdiv span {
    font-size: 16px;
}

#shopify-section-{{ section.id }} .subdiv b {
    font-size: 16px;
    font-weight:800;
    color:#00943b;
}

@media(max-width:768px){
   #shopify-section-{{ section.id }}.spaced-section .grid__item {
      width: 100%;
      max-width: 100%;
  }

  .subdiv svg {
    width: 13px !important;
  }

  #shopify-section-{{ section.id }} .subdiv {
      column-gap: 5px;
  }


   #shopify-section-{{ section.id }} .product__text.top-text {
      max-width: 100%;
      width: 100%;
  }

   #shopify-section-{{ section.id }} .slider-galeria {
      margin-bottom: 0px;
  }

  
}
