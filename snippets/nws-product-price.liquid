{% if cart.currency.iso_code == "CAD" %}{% assign cad = cart.currency.iso_code %}{% endif %}
{% if product.handle == "creatine-monohydrate-gummies-90-count" 
  or product.handle == "creatine-monohydrate-gummies-blue-raspberry-90-count"
  or product.handle == "creatine-monohydrate-gummies-watermelon-90-count"
  or product.handle == "creatine-monohydrate-gummies-watermelon-90-count-1"
  or product.handle == "creatine-monohydrate-gummies-sour-green-apple-90-count-1" %}
   {% assign subp = 0.857 %}
{% endif %}
{% if product.handle == "creatine-monohydrate-gummies-180-count" 
  or product.handle == "creatine-monohydrate-gummies-blue-raspberry-180-count" 
  or product.handle == "creatine-monohydrate-gummies-watermelon-180-count"
  or product.handle == "creatine-monohydrate-gummies-sour-green-apple-180-count" %}
   {% assign subp = 0.92 %}
{% endif %}
{% if product.handle == "creatine-monohydrate-gummies-270-count" 
  or product.handle == "creatine-monohydrate-gummies-blue-raspberry-270-count"
  or product.handle == "creatine-monohydrate-gummies-watermelon-270-count" 
  or product.handle == "creatine-monohydrate-gummies-starter-270-count"
  or product.handle == "creatine-monohydrate-gummies-sour-green-apple-270-count" %}
   {% assign subp = 0.8334 %}
{% endif %}
{% if product.handle == "creatine-monohydrate-gummies-starter-pack-2" %}
   {% assign subp = 0.909 %}
{% endif %}
{% comment %}
    Renders a list of product's price (regular, sale, unit)
    Accompanies product forms and meant to be updated dynamically
    Accepts:
    - variant: {Object} Variant Liquid object (optional)
    - product: {Object} Product Liquid object (optional)
    - show_vendor: {Boolean} Show the product's vendor depending on the section setting (optional)

    Usage:
    {% include 'product-price', variant: current_variant, product: product %}
{% endcomment %}
{%- liquid
  if variant.title
    assign compare_at_price = variant.compare_at_price
    assign price = variant.price
    assign available = variant.available
  else
    assign compare_at_price = 1999
    assign price = 1999
    assign available = true
  endif

  assign money_price = price | money
-%}

<dl class="price
  {% if available == false %} price--sold-out {% endif %}
  {% if compare_at_price > price %} price--on-sale {% endif %}
  {% if variant.unit_price_measurement %} price--unit-available {% endif %}"
  data-price
>
  {%- comment -%}
    Explanation of description list:
      - div.price__regular: Displayed when there are no variants on sale
      - div.price__sale: Displayed when a variant is a sale
      - div.price__unit: Displayed when the first variant has a unit price
      - div.price__availability: Displayed when the product is sold out
  {%- endcomment -%}
  <div class="price__pricing-group">
    <div class="price__regular">
      <dd>
        <span class="price-item price-item--regular" data-regular-price>
          {{ money_price }}
        </span>
      </dd>
    </div>
    <div class="price__sale">
      <dd>
        <span class="price-item price-item--sale" data-sale-price>
          {{ money_price }}
        </span>
      </dd>
      <dd>
        <s class="price-item price-item--regular" data-regular-price>
          {{ compare_at_price | money }}
        </s>
      </dd>
    </div>
    <div class="price__badges">
      <span class="price__badge price__badge--sale" aria-hidden="true">
        <span>{{ 'products.product.on_sale' | t }}</span>
      </span>
      <span class="price__badge price__badge--sold-out">
        <span>{{ 'products.product.sold_out' | t }}</span>
      </span>
    </div>
  </div>
</dl>
{% style %}
  .rc-radio__label.rc_widget__option__label .rc-option__price.rc_widget__price.rc_widget__price--subsave {
      display: block;
  }
  .rc-radio__label.rc_widget__option__label .rc-option__price.rc_widget__price.rc_widget__price--onetime {
      font-size: 0;
  }
  {% if compare_at_price > price %}
    .rc-radio__label.rc_widget__option__label .rc-option__price.rc_widget__price.rc_widget__price--subsave::before {
        content: "{{ compare_at_price | money }} {{ cad }}";
        margin-right: 5px;
        text-decoration: line-through;
        font-weight: 400;
        font-size: 16px;
    }
    .rc-radio__label.rc_widget__option__label .rc-option__price.rc_widget__price.rc_widget__price--subsave::after {
        content: "{{ compare_at_price | times: subp | money }} {{ cad }}";
        font-weight: 600;
        font-size: 16px;
    }
    .rc-radio__label.rc_widget__option__label .rc-option__price.rc_widget__price.rc_widget__price--onetime:before {
        content: "{{ compare_at_price | money }} {{ cad }}";
        margin-right: 5px;
        text-decoration: line-through;
        font-weight: 400;
        font-size: 16px;
    }
    .rc-radio__label.rc_widget__option__label .rc-option__price.rc_widget__price.rc_widget__price--onetime:after {
        content: "{{ money_price }} {{ cad }}";
        font-weight: 600;
        font-size: 16px;
    }
  {% else %}
    .rc-radio__label.rc_widget__option__label .rc-option__price.rc_widget__price.rc_widget__price--subsave::before {
        content: "{{ money_price }} {{ cad }}";
        margin-right: 5px;
        text-decoration: line-through;
        font-weight: 400;
        font-size: 16px;
    }
    .rc-radio__label.rc_widget__option__label .rc-option__price.rc_widget__price.rc_widget__price--subsave::after {
        content: "{{ price | times: subp | money }} {{ cad }}";
        font-weight: 600;
        font-size: 16px;
    }
    .rc-radio__label.rc_widget__option__label .rc-option__price.rc_widget__price.rc_widget__price--onetime:before {
        content: "{{ money_price }} {{ cad }}";
        font-weight: 600;
        font-size: 16px;
    }
  {% endif %}
  .rc-radio__label.rc_widget__option__label .rc-option__price.rc_widget__price.rc_widget__price--subsave,
  .rc-radio__label.rc_widget__option__label .rc-option__price.rc_widget__price.rc_widget__price--onetime {
      font-weight: 600;
  }
  .rc-option__onetime .rc-radio__label.rc_widget__option__label .rc-option__text::after {
      text-decoration: none;
      font-weight: 600;
  }
  .price__pricing-group.nws-chk-pr dd .price-item.price-item--regular {
      display: none;
  }
  .nws-pdp-template-form .product-form .product__price .price-item--sale {
      margin-left: 5px;
  }
  .nws-pdp-template-form .product-form .product__price .price__badge.price__badge--sale {
      color: red;
  }
  .nws-pdp-template-form .product-form .product__price .price-item.price-item--sale {
      display: none;
  }
  .nws-pdp-template-rc .rc-container-wrapper .rc-option.rc_widget__option .rc-radio__label::before,
  .nws-pdp-template-rc .rc-container-wrapper .rc-option.rc_widget__option .rc-radio__label::after {
  	display: none;
  }
  .nws-pdp-template-rc .rc-container-wrapper .rc-option.rc_widget__option .rc-radio__label {
  	padding-left: 0;
  	margin-left: 0;
  }
  .nws-pdp-template-rc .rc-container-wrapper .rc-option.rc_widget__option {
  	padding: 18px 20px !important;
  }
  .nws-pdp-template-rc .rc-widget-injection-parent ul.nws-rc-custom-values {
  	padding: 15px 0 10px 0px;
  	display: flex;
  	font-size: 14px;
  	margin: 0;
  	border-top: 1px solid #c7ccd3;
  	margin-top: 15px;
  	flex-wrap: wrap;
  }
  .nws-pdp-template-rc .rc-widget-injection-parent ul.nws-rc-custom-values li {
  	padding: 5px 0 0 0px;
  	background: none;
  	width: 50%;
  }
  .rc-radio__label.rc_widget__option__label .rc-option__price.rc_widget__price.rc_widget__price--subsave {
  	display: block;
  	font-size: 0px;
  	line-height: normal;
  	margin-top: 5px;
  }
  .nws-pdp-template-rc .rc-container-wrapper .rc-option.rc_widget__option.rc-option--active .rc-radio__label .rc-option__text {
  	font-weight: 600;
  	text-transform: capitalize;
  }
  .nws-pdp-template-rc .rc-container-wrapper .rc-option.rc_widget__option.rc-option--active .rc-option__discount.rc_widget__option__discount {
    font-weight: 600;
    color: red;
    font-size: 0;
  }
  .nws-pdp-template-rc .rc-container-wrapper .rc-option.rc_widget__option .rc-option__discount.rc_widget__option__discount {
    font-size: 0;
  }
  .nws-pdp-template-rc .rc-container-wrapper .rc-option.rc_widget__option .rc-option__discount.rc_widget__option__discount:before {
    font-weight: 600;
    content: "{{ 1 | minus: subp | times: 100 }}%";
    font-size: 14px;
    line-height: normal;
  }
  .nws-pdp-template-rc .rc-widget-injection-parent ul.nws-rc-custom-values li::before {
  	content: "✔";
  	margin-right: 5px;
  	display: inline-block;
  	color: #f57e25;
  }
  .nws-pdp-template-rc .rc-container-wrapper .rc-option.rc_widget__option.rc-option--active {
  	border-color: #f57e25;
  }
  .nws-pdp-template-rc .rc-container-wrapper .rc-option.rc_widget__option.rc-option--active .rc-option__discount.rc_widget__option__discount::after {
    margin-left: 8px;
  	font-size: 14px;
  	letter-spacing: normal;
  	max-width: 250px;
  	display: block;
  	width: 100%;
  	white-space: break-spaces;
  	position: absolute;
  	top: 0;
  	left: 160px;
  }
  {% if settings.subscribe_sale_label != blank %}
    .rc-template__legacy-radio .rc-radio.rc-option__subsave::after {
    	content: "{{settings.subscribe_sale_label}}";
    	position: absolute;
    	top: 0;
    	right: 0;
    	background: #f57e25;
    	font-size: 11px;
    	padding: 4px 20px;
    	color: #fff;
    	text-transform: uppercase;
    	font-weight: 600;
    }
  {% endif %}
  .nws-pdp-template-form .product-form .product__price {
  	margin-bottom: 20px;
  }
  .nws-pdp-template-form .nws-pdp-template-info {
  	margin-bottom: 15px;
  }
  .nws-pdp-template-form .product-form .product__price {
  	display: none;
  }
  .nws-pdp-blue-raspberry .rc-template__legacy-radio .rc-radio.rc-option__subsave::after {
  	background: #028fc8;
  }
  .nws-pdp-blue-raspberry .nws-pdp-template-rc .rc-container-wrapper .rc-option.rc_widget__option.rc-option--active {
  	border-color: #028fc8;
  }
  .nws-pdp-blue-raspberry .nws-pdp-template-rc .rc-widget-injection-parent ul.nws-rc-custom-values li::before {
  	color: #028fc8;
  }
  @media screen and (max-width:600px){
    .nws-pdp-template-rc .rc-widget-injection-parent ul.nws-rc-custom-values li {
    	padding: 2px 0 0 0px;
    	width: 100%;
    }
  }
{% endstyle %}