        "question_1_1": {
          "type": "question",
          "settings": {
            "heading": "What is creatine?",
            "content": "<p>Creatine is an amino acid found in your body’s muscles and brain. The body naturally produces creatine and it can be consumed through meat. It is the most studied fitness supplement on the market, and research shows it can increase strength, improve recovery, and boost mental acuity.</p>",
            "page": ""
          }
        },
        "question_1_2": {
          "type": "question",
          "settings": {
            "heading": "What are the main benefits of creatine supplementation?",
            "content": "<p>The main benefits of creatine are increasing strength, building muscle, muscle recovery, and improved mental acuity.</p>",
            "page": ""
          }
        },
        "question_1_3": {
          "type": "question",
          "settings": {
            "heading": "When should I take creatine?",
            "content": "<p>Creatine should be taken daily! There is no “right” time to take creatine, but we recommend taking it at a consistent time each day.</p>",
            "page": ""
          }
        },
        "question_YLYdTp": {
          "type": "question",
          "settings": {
            "heading": "When will I see results?",
            "content": "<p>You may experience the benefits of creatine supplementation within 2-3 weeks.</p>",
            "page": ""
          }
        },
        "question_6CmCMx": {
          "type": "question",
          "settings": {
            "heading": "Is creatine safe?",
            "content": "<p>Yes, creatine is safe! The FDA issued a “GRAS” rating on Creatine Monohydrate in 2020, which means creatine monohydrate is “Generally Recognized as Safe.”</p>",
            "page": ""
          }
        },
        "question_8NYVNt": {
          "type": "question",
          "settings": {
            "heading": "Can women take creatine?",
            "content": "<p>Yes, in fact research shows that women may benefit the most from proper creatine supplementation.</p>",
            "page": ""
          }
        },
        "category_1": {
          "type": "category",
          "settings": {
            "heading": "Core - Creatine Monohydrate Gummies"
