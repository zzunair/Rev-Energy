    "nws_about_creatine_tfiBfC": {
      "type": "nws-about-creatine",
      "blocks": {
        "block_fgYMHz": {
          "type": "block",
          "settings": {
            "para": "<p>Creatine is naturally produced in your body and is also consumed when eating red meat, poultry, and fish.</p>",
            "text-border": false,
            "t-size": 16,
            "t-color": "#fff2d2"
          }
        },
        "block_kmknyN": {
          "type": "block",
          "settings": {
            "para": "<p>Creatine supplementation increases your body's stores of phosphocreatine, which is used to produce new ATP during high-intensity exercise. ATP is the energy-carrying molecule found in the cells of all living things.</p>",
            "text-border": true,
            "t-size": 16,
            "t-color": "#fff2d2"
          }
        },
        "block_XWwXY9": {
          "type": "block",
          "settings": {
            "para": "<p>Because creatine is so bio-available, absorption is just as efficacious in gummy form as it is in powder form. </p>",
            "text-border": false,
            "t-size": 16,
            "t-color": "#f77f26"
          }
        }
      },
      "block_order": [
        "block_fgYMHz",
        "block_kmknyN",
        "block_XWwXY9"
      ],
      "settings": {
        "heading": "About Creatine",
        "text-area": "Creatine is made up of three different amino acids: glycine, arginine, and methionine.",
        "center-img": "shopify://shop_images/creatine-group.png"
      }
    },
