          "type": "block",
          "settings": {
            "para": "<p>Our mission is to improve the health & wellness outcomes of our customers. Our vision is that 100 Million Americans are regularly taking creatine by 2030.</p>",
            "prd-url": ""
          }
        },
        "block_EwqVyt": {
          "type": "block",
          "settings": {
            "para": "<p>We believe that anyone who lives an active lifestyle, seeks enhanced performance or values overall wellness can benefit from proper creatine supplementation. Due to a variety of factors (stigma, unenjoyable product experience, lack of awareness) only 2 million Americans regularly take creatine.</p>",
            "prd-url": ""
          }
        }
      },
